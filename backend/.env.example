PORT=3000
# Where stats.json is stored. Point at a persistent disk in production.
DATA_DIR=./data
# Comma-separated frontend origins allowed to call the API (unset = any)
# Include every site that calls the API: the portfolio and the email dashboard
CORS_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app,https://your-email-dashboard.vercel.app
# Optional: require this key to read /api/stats
STATS_KEY=
